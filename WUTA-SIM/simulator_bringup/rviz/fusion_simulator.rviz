Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw LiDAR PointCloud
      Enabled: true
      Topic:
        Value: /hesai/pandar
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/MarkerArray
      Name: Fused Cone Map
      Enabled: true
      Topic:
        Value: /mapping/cone_map_viz
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: Planned Centerline
      Enabled: true
      Topic:
        Value: /planning/centerline_viz
    - Class: rviz_default_plugins/MarkerArray
      Name: Simulation Status
      Enabled: true
      Topic:
        Value: /system/status_viz
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 15
      Target Frame: base_link
Window Geometry:
  Width: 1280
  Height: 800
